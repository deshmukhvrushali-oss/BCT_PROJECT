:root {
  /* Default fallbacks if custom properties are undefined */
  --accent: #646cff;
  --accent-bg: rgba(100, 108, 255, 0.1);
  --accent-border: #747bff;
  --border: #e2e8f0;
  --text-h: #1a1a1a;
  --social-bg: #f9f9f9;
  --shadow: 0 4px 12px rgba(0, 0, 0, 0.1);
}

.counter {
  font-size: 1rem;
  padding: 0.3125rem 0.625rem;
  border-radius: 6px;
  color: var(--accent);
  background-color: var(--accent-bg);
  border: 2px solid transparent;
  margin-block-end: 1.5rem;
  transition: border-color 0.3s ease;

  &:hover {
    border-color: var(--accent-border);
  }

  &:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
}

.hero {
  position: relative;

  .base,
  .framework,
  .vite {
    inset-inline: 0;
    margin-inline: auto;
  }

  .base {
    width: 170px;
    position: relative;
    z-index: 0;
  }

  .framework,
  .vite {
    position: absolute;
  }

  .framework {
    z-index: 1;
    top: 34px;
    height: 28px;
    transform: perspective(2000px) rotateZ(300deg) rotateX(44deg) rotateY(39deg) scale(1.4);
  }

  .vite {
    z-index: 0;
    top: 107px;
    height: 26px;
    width: auto;
    transform: perspective(2000px) rotateZ(300deg) rotateX(40deg) rotateY(39deg) scale(0.8);
  }
}

#center {
  display: flex;
  flex-direction: column;
  place-content: center;
  place-items: center;
  gap: 1.5625rem;
  flex-grow: 1;

  @media (max-width: 1024px) {
    padding: 2rem 1.25rem 1.5rem;
    gap: 1.125rem;
  }
}

#next-steps {
  display: flex;
  border-top: 1px solid var(--border);
  text-align: left;

  & > div {
    flex: 1 1 0%;
    padding: 2rem;

    @media (max-width: 1024px) {
      padding: 1.5rem 1.25rem;
    }
  }

  .icon {
    width: 1.375rem;
    height: 1.375rem;
    margin-block-end: 1rem;
  }

  ul {
    list-style: none;
    padding: 0;
    display: flex;
    gap: 0.5rem;
    margin-block-start: 2rem;

    .logo {
      height: 1.125rem;
    }

    a {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.375rem 0.75rem;
      border-radius: 6px;
      color: var(--text-h);
      background-color: var(--social-bg);
      font-size: 1rem;
      text-decoration: none;
      transition: box-shadow 0.3s ease;

      &:hover {
        box-shadow: var(--shadow);
      }

      .button-icon {
        width: 1.125rem;
        height: 1.125rem;
      }
    }

    @media (max-width: 1024px) {
      margin-block-start: 1.25rem;
      flex-wrap: wrap;
      justify-content: center;

      li {
        flex: 1 1 calc(50% - 0.5rem);
      }

      a {
        width: 100%;
        justify-content: center;
        box-sizing: border-box;
      }
    }
  }

  @media (max-width: 1024px) {
    flex-direction: column;
    text-align: center;
  }
}

#docs {
  border-right: 1px solid var(--border);

  @media (max-width: 1024px) {
    border-right: none;
    border-bottom: 1px solid var(--border);
  }
}

#spacer {
  height: 5.5rem;
  border-top: 1px solid var(--border);

  @media (max-width: 1024px) {
    height: 3rem;
  }
}

.ticks {
  position: relative;
  width: 100%;

  &::before,
  &::after {
    content: '';
    position: absolute;
    top: -4.5px;
    border: 5px solid transparent;
  }

  &::before {
    left: 0;
    border-left-color: var(--border);
  }

  &::after {
    right: 0;
    border-right-color: var(--border);
  }
}